generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  password         String
  avatar           String?
  restaurants      Restaurant[]
  reviews          Review[]
  wishlist         Wishlist[]
  sentRequests     Friendship[]     @relation("requester")
  receivedRequests Friendship[]     @relation("addressee")
  createdOutings   Outing[]         @relation("creator")
  outingMembers    OutingMember[]
  proposals        OutingProposal[]
  votes            OutingVote[]
  createdAt        DateTime         @default(now())
}

model Restaurant {
  id            String           @id @default(uuid())
  name          String
  address       String
  cuisineType   String
  priceRange    Int
  googlePlaceId String?
  createdBy     String
  user          User             @relation(fields: [createdBy], references: [id])
  reviews       Review[]
  wishlist      Wishlist[]
  outings       Outing[]
  proposals     OutingProposal[]
}

model Review {
  id            String     @id @default(uuid())
  user          User       @relation(fields: [userId], references: [id])
  userId        String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  foodScore     Int
  serviceScore  Int
  ambianceScore Int
  valueScore    Int
  notes         String?
  visibility    String     @default("private")
  visitedAt     DateTime
  createdAt     DateTime   @default(now())
}

model Friendship {
  id          String   @id @default(uuid())
  requester   User     @relation("requester", fields: [requesterId], references: [id])
  requesterId String
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id])
  addresseeId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Wishlist {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  addedAt      DateTime   @default(now())
}

model Outing {
  id           String           @id @default(uuid())
  name         String
  creator      User             @relation("creator", fields: [creatorId], references: [id])
  creatorId    String
  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  date         DateTime?
  status       String           @default("planning")
  members      OutingMember[]
  proposals    OutingProposal[]
  votes        OutingVote[]
  createdAt    DateTime         @default(now())
}

model OutingMember {
  id       String @id @default(uuid())
  outing   Outing @relation(fields: [outingId], references: [id])
  outingId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  rsvp     String @default("pending")
}

model OutingProposal {
  id           String       @id @default(uuid())
  outingId     String
  restaurantId String
  proposedBy   String
  outing       Outing       @relation(fields: [outingId], references: [id], onDelete: Cascade)
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  proposer     User         @relation(fields: [proposedBy], references: [id])
  votes        OutingVote[]
  createdAt    DateTime     @default(now())

  @@unique([outingId, restaurantId])
}

model OutingVote {
  id         String         @id @default(uuid())
  outingId   String
  proposalId String
  userId     String
  outing     Outing         @relation(fields: [outingId], references: [id], onDelete: Cascade)
  proposal   OutingProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([proposalId, userId])
}
